{
  "name": "cursorbot",
  "version": "0.2.0",
  "private": true,
  "description": "Telegram ↔ Cursor ACP bridge — drive Cursor agents on your local repos from your phone.",
  "type": "module",
  "license": "MIT",
  "author": "Michel Lima",
  "keywords": [
    "cursor",
    "cursor-acp",
    "telegram",
    "telegram-bot",
    "agent",
    "ai",
    "automation",
    "personal-assistant",
    "remote-coding",
    "messenger",
    "grammy"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "cursorbot": "./dist/bin/cursorbot.js",
    "cursorbot-attach-image": "./dist/tools/attach-image.js",
    "cursorbot-attach-file": "./dist/tools/attach-file.js"
  },
  "scripts": {
    "dev": "tsx watch src/bin/cursorbot.ts",
    "build": "tsup",
    "start": "node dist/bin/cursorbot.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "audit:security": "node scripts/audit-security.mjs"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dayjs": "^1.11.20",
    "grammy": "^1.42.0",
    "mime-types": "^3.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "3.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
